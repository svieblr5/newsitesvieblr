# Normalize all text files to LF in the repo AND the working tree.
# Ends the mixed CRLF/LF churn that made diffs rewrite whole files. LF also
# matches the Linux deploy target (Hostinger).
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svgz  binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.webm  binary
*.docx  binary
