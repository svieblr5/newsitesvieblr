# SVIE CMS — Environment Variables
# Copy this file to .env and fill in your values.

# ── Session security (required in production) ──
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Node environment ──
NODE_ENV=production
PORT=3000

# ── Visitor notifications are configured inside the CMS dashboard ──
# No external paid services required. Telegram and Email are set up
# directly in Admin → Visitor Dashboard → Notification Settings.
