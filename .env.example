# SVIE CMS — Environment Variables
# Copy this file to .env and fill in your values.

# ── Session security (required in production) ──
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Node environment ──
NODE_ENV=production
PORT=3000

# ── SMTP / email password (recommended: keep secrets out of config.json) ──
# The Gmail "App Password" used to send visitor alerts and enquiry emails.
# If set here (or in the host's environment panel), it takes precedence over
# any value stored in data/config.json and the admin field is locked/read-only.
# Leave blank to keep managing it from Admin → Visitor Dashboard instead.
SMTP_PASS=

# ── Visitor notifications are otherwise configured inside the CMS dashboard ──
# No external paid services required. Sender address, recipient, and toggles
# are set in Admin → Visitor Dashboard → Notification Settings.
